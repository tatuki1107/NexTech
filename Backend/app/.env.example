# Bun loads Backend/app/.env automatically when run from this directory.
# Match POSTGRES_DB, POSTGRES_USER and POSTGRES_PASSWORD in the root .env.
DATABASE_URL=postgresql://nextech:nextech_dev_password@localhost:5432/nextech
NODE_ENV=development
PORT=3001
# Replace this development example before deploying.
JWT_SECRET=development-only-secret-at-least-32-chars
JWT_ISSUER=nextech-api
JWT_AUDIENCE=nextech-web
ALLOWED_ORIGINS=http://localhost:3000
# Optional local seed credentials. Never use these accounts in production.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=development-admin-password
SEED_USER_PASSWORD=development-user-password
